# ─────────────────────────────────────
# 온글(On-Geul) 백엔드 환경변수 예시
# 실제 .env 파일에 값을 채워서 사용하세요
# .env 파일은 절대 GitHub에 올리지 마세요!
# ─────────────────────────────────────

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Groq Whisper
GROQ_API_KEY=your_groq_api_key

# Google Calendar OAuth2
# Google Cloud Console > API 및 서비스 > OAuth 클라이언트 ID 에서 발급
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Slack Incoming Webhook
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Firebase
# Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_DATABASE_URL=https://<your-project>.firebaseio.com

# Neo4j AuraDB
NEO4J_URI=neo4j+s://...
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=...

# 서버 설정
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-url.run.app


# API 키 없이 화면과 파이프라인을 확인할 때 true로 사용
DUMMY_MODE=true
DUMMY_STT=true
